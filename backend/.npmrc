# bullmq@5.7x declares an *optional* peer dependency on redis@>=5, but this
# project pins redis@^4.7 (bullmq itself uses ioredis at runtime, not node-redis).
# The optional peer is harmless; this keeps npm from failing the install over it
# and makes local `npm install`, CI, and Docker `npm ci` resolve identically.
legacy-peer-deps=true
